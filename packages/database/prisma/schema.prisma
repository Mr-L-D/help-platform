generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum USER_ROLE {
  USER
  ADMIN
}

enum TASK_TYPE {
  HELP
  SKILL
  COMMUNITY
}

enum REWARD_TYPE {
  FREE
  PAID
}

enum TASK_STATUS {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ORDER_STATUS {
  ACCEPTED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  openid       String?  @unique
  unionid      String?
  nickname     String
  avatar       String
  username     String?
  passwordHash String?  @map("password_hash")
  phone        String?
  role         USER_ROLE @default(USER)
  points       Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  publishedTasks Task[] @relation("Publisher")
  orders         Order[]

  @@map("users")
}

model Category {
  id   String   @id @default(uuid())
  name String
  icon String
  type TASK_TYPE

  tasks Task[]

  @@map("categories")
}

model Task {
  id           String     @id @default(uuid())
  publisherId  String     @map("publisher_id")
  title        String
  description  String     @db.Text
  type         TASK_TYPE
  categoryId   String     @map("category_id")
  rewardType   REWARD_TYPE @map("reward_type")
  rewardAmount Decimal?   @map("reward_amount") @db.Decimal(10, 2)
  images       Json       @default("[]")
  location     String?
  status       TASK_STATUS @default(OPEN)
  createdAt    DateTime   @default(now()) @map("created_at")

  publisher User       @relation("Publisher", fields: [publisherId], references: [id])
  category  Category   @relation(fields: [categoryId], references: [id])
  orders    Order[]

  @@map("tasks")
}

model Order {
  id        String      @id @default(uuid())
  taskId    String      @map("task_id")
  helperId  String      @map("helper_id")
  status    ORDER_STATUS @default(ACCEPTED)
  createdAt DateTime    @default(now()) @map("created_at")

  task   Task @relation(fields: [taskId], references: [id])
  helper User @relation(fields: [helperId], references: [id])

  @@map("orders")
}
