{
  "name": "help-platform",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,vue,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,vue,js,jsx,json,css,md}\"",
    "db:push": "pnpm --filter @help-platform/database db:push",
    "db:generate": "pnpm --filter @help-platform/database db:generate"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "globals": "15.15.0",
    "prettier": "3.8.3",
    "turbo": "2.9.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20"
  }
}
